# ─────────────────────────────────────────────────────────────────────────────
# PrintfY — environment variables
# Copy this file to `.env.local` and fill in your own keys.
#   cp .env.example .env.local
# Never commit real secrets — `.env*` is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth — Clerk (REQUIRED) ──────────────────────────────────────────────────
# Create a free application at https://dashboard.clerk.com and copy the keys.
# See CLERK_SETUP.md for a step-by-step guide.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Background removal — remove.bg (OPTIONAL) ────────────────────────────────
# Free key (50 previews/mo): https://www.remove.bg/api
# If omitted, the app gracefully falls back to the original image.
REMOVE_BG_API_KEY=your_remove_bg_key

# ── Server-side enhancement — Cloudinary (OPTIONAL) ──────────────────────────
# Free account: https://cloudinary.com — used by /api/enhance for auto-improve,
# sharpen and face-aware passport crop. Falls back to the original if unset.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── AI super-resolution — Hugging Face (OPTIONAL) ────────────────────────────
# Free token: https://huggingface.co/settings/tokens — used by /api/enhance-ai.
# Falls back to the original image if unset or the model is cold-starting.
HF_API_TOKEN=hf_your_token_here
